  "process_bindings": {
    "schema": 1,
    "clock_register": 59,
    "config_generation_register": 61,
    "format_register": 63,
    "slot_base": 64,
    "slot_count": 3,
    "slot_words": 16,
    "status_register": 112,
    "count_register": 113,
    "digest_start": 114,
    "digest_words": 16,
    "clock": "boot_monotonic_read_completion",
    "calibration": "provisional",
    "slot_layout": [
      {
        "offset": 0,
        "words": 2,
        "name": "value",
        "encoding": "s32_be"
      },
      {
        "offset": 2,
        "words": 1,
        "name": "quality",
        "encoding": "enum"
      },
      {
        "offset": 3,
        "words": 1,
        "name": "flags",
        "encoding": "bit0=usable bit1=has_sample bit2=has_value bit3=unique_serial"
      },
      {
        "offset": 4,
        "words": 2,
        "name": "read_ms",
        "encoding": "u32_be"
      },
      {
        "offset": 6,
        "words": 2,
        "name": "sequence",
        "encoding": "u32_be"
      },
      {
        "offset": 8,
        "words": 2,
        "name": "acquisition_epoch",
        "encoding": "u32_be"
      },
      {
        "offset": 10,
        "words": 2,
        "name": "errors",
        "encoding": "u32_be"
      },
      {
        "offset": 12,
        "words": 2,
        "name": "losses_min",
        "encoding": "u32_be"
      },
      {
        "offset": 14,
        "words": 2,
        "name": "inventory_generation",
        "encoding": "u32_be"
      }
    ],
    "quality": {
      "0": "unbound",
      "1": "awaiting",
      "2": "valid",
      "3": "warmup",
      "4": "io_error",
      "5": "crc_error",
      "6": "overflow",
      "7": "stale",
      "8": "paused",
      "9": "missing",
      "10": "identity_mismatch",
      "11": "route_error",
      "12": "value_invalid",
      "13": "config_invalid"
    },
    "status": "0=valid configuration (possibly unbound),1=storage unavailable,2=stored configuration invalid",
