{
  "schema": "tbd.logic-project/v1",
  "id": "reservoir-pid",
  "name": "Reservoir level PID",
  "revision": 1,
  "program": {
    "scan_ms": 50,
    "nets": [
      {
        "id": "N1",
        "label": "PID holds tank level at setpoint (CV drives the pump)",
        "expr": {
          "t": "pid",
          "inst": 0,
          "sp": {
            "t": "wsrc",
            "io": "IW",
            "idx": 0
          },
          "pv": {
            "t": "wsrc",
            "io": "IW",
            "idx": 1
          },
          "kp": {
            "t": "k",
            "k": 120
          },
          "ki": {
            "t": "k",
            "k": 8
          },
          "kd": {
            "t": "k",
            "k": 40
          },
          "omin": {
            "t": "k",
            "k": 0
          },
          "omax": {
            "t": "k",
            "k": 255
          },
          "id": "e1"
        },
        "coil": {
          "io": "QW",
          "idx": 0
        }
      },
      {
        "id": "N2",
        "label": "High-level alarm",
        "expr": {
          "t": "cmp",
          "idx": 1,
          "op": "GE",
          "k": 90,
          "id": "e2"
        },
        "coil": {
          "io": "QX",
          "idx": 0,
          "neg": false
        }
      },
      {
        "id": "N3",
        "label": "Low-level alarm",
        "expr": {
          "t": "cmp",
          "idx": 1,
          "op": "LE",
          "k": 5,
          "id": "e3"
        },
        "coil": {
          "io": "QX",
          "idx": 1,
          "neg": false
        }
      }
    ]
  },
  "symbols": {
    "IW0": {
      "name": "level_setpoint",
      "comment": "Operator setpoint, percent of full (0-100)"
    },
    "IW1": {
      "name": "level_pct",
      "comment": "Measured tank level, percent of full"
    },
    "QW0": {
      "name": "pump_speed",
      "comment": "PID control value -> pump/valve drive (0-255)"
    },
    "QX0": {
      "name": "high_alarm",
      "comment": "Level at or above 90%"
    },
    "QX1": {
      "name": "low_alarm",
      "comment": "Level at or below 5%"
    }
  },
  "settings": {
    "bindings": {
      "digital_inputs": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "digital_outputs": [
        0,
        1,
        2,
        3
      ],
      "word_inputs": [
        "parameter",
        "parameter",
        "parameter",
        "parameter",
        "parameter",
        "parameter",
        "parameter",
        "parameter"
      ]
    },
    "parameters": [
      0,
      0,
      0,
      0,
      0,
      0,
      0,
      0
    ]
  }
}
