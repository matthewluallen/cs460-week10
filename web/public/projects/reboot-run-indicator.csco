{
  "schema": "tbd.logic-project/v1",
  "id": "reboot-run-indicator",
  "name": "Reboot RUN indicator",
  "revision": 1,
  "program": {
    "scan_ms": 50,
    "startup": {"mode":"run"},
    "nets": [{"id":"N1","label":"Request drives the indicator","expr":{"t":"c","id":"e1","io":"IX","idx":0,"neg":false},"coil":{"io":"QX","idx":0,"neg":false}}]
  },
  "symbols": {
    "IX0": {"name":"request","comment":"Logical input 0 uses physical input 0"},
    "QX0": {"name":"indicator","comment":"Logical output 0 uses physical relay 0"}
  },
  "settings": {
    "bindings": {"digital_inputs":[0,1,2,3,4,5,6,7],"digital_outputs":[0,1,2,3],"word_inputs":["parameter","parameter","parameter","parameter","parameter","parameter","parameter","parameter"]},
    "parameters": [0,0,0,0,0,0,0,0],
    "host_acl": {
      "enabled": false,
      "rules": [
        {"point":"DI0","host":"192.0.2.10","access":"r"},
        {"point":"COIL1","host":"192.0.2.10","access":"r"}
      ]
    }
  },
  "experiment": {"control_route":"baseline","notes":"Explicit reboot RUN example. Load stays PROGRAM; after reboot, readiness must pass within 30 seconds. Host policy is disabled; sample addresses are placeholders. Record actual mode, startup receipt, profile and project hash."}
}
