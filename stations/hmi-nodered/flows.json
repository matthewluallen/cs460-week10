    {
        "id": "fn_phone",
        "type": "function",
        "name": "phone -> IW",
        "func": "const r = msg.payload;\n// plc_core maps phone sensors to Modbus regs 50/51/52 when fresh\nconst lux  = {payload: r[50]||0};          // ambient light (lux)\nconst acc  = {payload: (r[51]||0)/100};    // |a| m/s^2 (stored x100)\nconst tilt = {payload: r[52]||0};          // tilt beta (deg, signed)\nreturn [lux, acc, tilt];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 560,
        "wires": [
