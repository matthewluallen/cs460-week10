        "type": "ui_template",
        "group": "g_in",
        "name": "Input LEDs",
        "order": 1,
        "width": 6,
        "height": 2,
        "format": "<style>\n.drow{display:flex;flex-wrap:wrap;gap:10px}\n.di{flex:1 1 70px;text-align:center;padding:8px 4px;border-radius:8px;background:#1b2330;color:#9fb0c3;font:600 12px system-ui}\n.di .dot{width:14px;height:14px;border-radius:50%;margin:0 auto 6px;background:#30405a}\n.di.on{color:#eaf6ff}.di.on .dot{background:#4aa3ff;box-shadow:0 0 10px #4aa3ff}\n.di.phone.on .dot{background:#b084ff;box-shadow:0 0 10px #b084ff}\n</style>\n<div class=\"drow\">\n  <div class=\"di\" ng-class=\"{on:msg.payload.START}\"><div class=\"dot\"></div>DI0 START</div>\n  <div class=\"di\" ng-class=\"{on:msg.payload.STOP}\"><div class=\"dot\"></div>DI1 STOP</div>\n  <div class=\"di\" ng-class=\"{on:msg.payload.ESTOP_IN}\"><div class=\"dot\"></div>DI2 ESTOP</div>\n  <div class=\"di phone\" ng-class=\"{on:msg.payload.BTN1}\"><div class=\"dot\"></div>%IX6 BTN1</div>\n  <div class=\"di phone\" ng-class=\"{on:msg.payload.BTN2}\"><div class=\"dot\"></div>%IX7 BTN2</div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
