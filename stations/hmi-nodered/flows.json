    {
        "id": "fn_di",
        "type": "function",
        "name": "DI mirror -> leds",
        "func": "const c = msg.payload;  // DI_MIRROR_BASE=100; index 0..7 = DI0..DI7\nmsg.payload = {\n  START:!!c[0], STOP:!!c[1], ESTOP_IN:!!c[2],\n  BTN1:!!c[6], BTN2:!!c[7]   // phone momentary buttons -> %IX6/%IX7\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 860,
