    {
        "id": "ui_dash",
        "type": "ui_template",
        "group": "g_main",
        "name": "Plant HMI",
        "order": 1,
        "width": 25,
        "height": 16,
        "format": "<style>\n.cs{--bg:#0b1220;--panel:#111a28;--pan2:#0f1724;--line:#243049;--mut:#7d8ba3;--ink:#eaf6ff;\n  font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,sans-serif;color:var(--ink);\n  background:var(--bg);width:100%;box-sizing:border-box}\n.cs *{box-sizing:border-box}\n.cs .hdr{display:flex;align-items:center;gap:14px;padding:10px 16px;background:linear-gradient(90deg,#0f7a86,#0b5a63);border-radius:10px;margin-bottom:10px}\n.cs .hdr .logo{font-weight:800;font-size:18px;letter-spacing:.02em}\n.cs .hdr .sub{color:#bfe9ee;font-size:12.5px}\n.cs .hdr .sp{flex:1}\n.cs .pill{display:inline-block;padding:4px 14px;border-radius:999px;font-weight:800;font-size:15px;color:#0d1117}\n.cs .m-RUN{background:#39d98a}.cs .m-IDLE{background:#f0c33e}.cs .m-BOOT{background:#9fb0c3}\n.cs .m-FAULT{background:#ff5d5d;color:#fff}.cs .m-UNK{background:#9fb0c3}\n.cs .comms{font-size:13px;color:#eafff6}.cs .comms .d{color:#aeffd9}\n.cs .grid{display:grid;grid-template-columns:1.15fr 1fr;grid-auto-rows:min-content;gap:10px}\n.cs .card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:11px 13px}\n.cs .card h3{margin:0 0 9px;font-size:11px;letter-spacing:.07em;text-transform:uppercase;color:var(--mut);font-weight:700}\n.cs .kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:9px;margin-bottom:10px}\n.cs .kpi{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:9px 11px}\n.cs .kpi .l{font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--mut);font-weight:700}\n.cs .kpi .v{font-size:21px;font-weight:800;margin-top:2px;line-height:1.1}\n.cs .kpi .u{font-size:11px;color:var(--mut);font-weight:600}\n.cs .kpi.alarm{border-color:#ff5d5d;background:#241315}.cs .kpi.warn{border-color:#f0a33e;background:#241e12}\n.cs .bars{display:grid;grid-template-columns:1fr 1fr;gap:8px 16px}\n.cs .bar .t{display:flex;justify-content:space-between;font-size:12px;color:#c4d0e0;margin-bottom:4px}\n.cs .bar .t b{color:var(--ink);font-weight:800;font-size:13px}\n.cs .bar .track{height:8px;background:#0b1320;border:1px solid var(--line);border-radius:6px;overflow:hidden}\n.cs .bar .fill{height:100%;background:linear-gradient(90deg,#2bd47f,#39d98a)}\n.cs .bar.warnf .fill{background:linear-gradient(90deg,#f0c33e,#ffd56b)}\n.cs .leds{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}\n.cs .led{text-align:center;padding:8px 3px;border-radius:8px;background:var(--pan2);border:1px solid #1d2941;color:#8fa0b8;font-weight:700;font-size:11px}\n.cs .led .dot{width:13px;height:13px;border-radius:50%;margin:0 auto 5px;background:#2a3952;box-shadow:inset 0 0 3px #000}\n.cs .led.on{color:var(--ink);border-color:#2f6b4e}.cs .led.on .dot{background:#39d98a;box-shadow:0 0 9px #39d98a}\n.cs .led.estop.on{border-color:#7a2f2f}.cs .led.estop.on .dot{background:#ff5d5d;box-shadow:0 0 9px #ff5d5d}\n.cs .led.in.on .dot{background:#4aa3ff;box-shadow:0 0 9px #4aa3ff}\n.cs .led.ph.on .dot{background:#b084ff;box-shadow:0 0 9px #b084ff}\n.cs .led small{display:block;font-size:8.5px;color:#6f7f98;font-weight:600;margin-top:1px}\n.cs .logwrap{display:flex;flex-direction:column;min-height:0}\n.cs .log{flex:1;overflow:auto;border:1px solid var(--line);border-radius:8px;background:var(--pan2);font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px}\n.cs .lrow{display:grid;grid-template-columns:66px 54px 1fr;gap:7px;align-items:center;padding:6px 10px;border-bottom:1px solid #18212f}\n.cs .lrow:last-child{border-bottom:none}\n.cs .lrow .lt{color:#6f7f98}.cs .lrow .lb{justify-self:start;padding:1px 7px;border-radius:5px;font-weight:800;font-size:10px;font-family:-apple-system,sans-serif}\n.cs .s-INFO .lb{background:#22304a;color:#9fc0ff}\n.cs .s-WARN{background:#1f1a10}.cs .s-WARN .lb{background:#6a4a12;color:#ffd58a}.cs .s-WARN .lm{color:#ffe6bd}\n.cs .s-ALARM{background:#241113}.cs .s-ALARM .lb{background:#7a1f22;color:#ff9ea0}.cs .s-ALARM .lm{color:#ffc9cb}\n.cs .s-SEC{background:#1c1226}.cs .s-SEC .lb{background:#5a2a86;color:#e0b6ff}.cs .s-SEC .lm{color:#eccbff}\n.cs .empty{color:#6f7f98;padding:16px;text-align:center}\n.cs .ph{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;text-align:center}\n.cs .ph .pv{background:var(--pan2);border:1px solid #1d2941;border-radius:8px;padding:8px 4px}\n.cs .ph .pv .pl{font-size:10px;color:var(--mut);text-transform:uppercase;letter-spacing:.05em;font-weight:700}\n.cs .ph .pv .pn{font-size:18px;font-weight:800;margin-top:2px}.cs .ph .pv .pu{font-size:10px;color:var(--mut)}\n.cs .colL{display:flex;flex-direction:column;gap:10px}\n.cs .colR{display:flex;flex-direction:column;gap:10px;min-height:0}\n</style>\n<div class=\"cs\" ng-init=\"d=msg.payload||{}\">\n  <div class=\"hdr\">\n    <span class=\"logo\">&#9893; CS460 Plant HMI</span>\n    <span class=\"sub\">PLC 10.20.30.10 &middot; Modbus/TCP :502</span>\n    <span class=\"pill\" ng-class=\"'m-'+(msg.payload.modeClass||'UNK')\">{{msg.payload.mode||'&mdash;'}}</span>\n    <span class=\"sp\"></span>\n    <span class=\"comms\"><span class=\"d\">&#9679;</span> live &middot; {{msg.payload.clock}}</span>\n  </div>\n  <div class=\"kpis\">\n    <div class=\"kpi\"><div class=\"l\">Heartbeat</div><div class=\"v\">{{msg.payload.hb}}</div></div>\n    <div class=\"kpi\"><div class=\"l\">Scan max</div><div class=\"v\">{{msg.payload.scan}} <span class=\"u\">&micro;s</span></div></div>\n    <div class=\"kpi\" ng-class=\"{alarm:msg.payload.faults>0}\"><div class=\"l\">Faults</div><div class=\"v\">{{msg.payload.faults}}</div></div>\n    <div class=\"kpi\" ng-class=\"{warn:msg.payload.forces>0}\"><div class=\"l\">Forces</div><div class=\"v\">{{msg.payload.forces}}</div></div>\n    <div class=\"kpi\"><div class=\"l\">Temp</div><div class=\"v\">{{msg.payload.temp}} <span class=\"u\">&deg;C</span></div></div>\n    <div class=\"kpi\"><div class=\"l\">Setpoint</div><div class=\"v\">{{msg.payload.sp}} <span class=\"u\">&deg;C</span></div></div>\n  </div>\n  <div class=\"grid\">\n    <div class=\"colL\">\n      <div class=\"card\">\n        <h3>Process &amp; phone points (network-only)</h3>\n        <div class=\"bars\">\n          <div class=\"bar\"><div class=\"t\"><span>Temperature</span><b>{{msg.payload.temp}} &deg;C</b></div><div class=\"track\"><div class=\"fill\" ng-style=\"{width:(msg.payload.temp/80*100)+'%'}\"></div></div></div>\n          <div class=\"bar\"><div class=\"t\"><span>Setpoint</span><b>{{msg.payload.sp}} &deg;C</b></div><div class=\"track\"><div class=\"fill\" ng-style=\"{width:(msg.payload.sp/80*100)+'%'}\"></div></div></div>\n        </div>\n        <div class=\"ph\" style=\"margin-top:10px\">\n          <div class=\"pv\"><div class=\"pl\">Light</div><div class=\"pn\">{{msg.payload.lux}}</div><div class=\"pu\">lux</div></div>\n          <div class=\"pv\"><div class=\"pl\">Accel</div><div class=\"pn\">{{msg.payload.acc}}</div><div class=\"pu\">m/s&sup2;</div></div>\n          <div class=\"pv\"><div class=\"pl\">Tilt &beta;</div><div class=\"pn\">{{msg.payload.tilt}}</div><div class=\"pu\">&deg;</div></div>\n        </div>\n      </div>\n      <div class=\"card\">\n        <h3>Relays &amp; outputs</h3>\n        <div class=\"leds\">\n          <div class=\"led estop\" ng-class=\"{on:msg.payload.relays.ESTOP}\"><div class=\"dot\"></div>E-STOP</div>\n          <div class=\"led\" ng-class=\"{on:msg.payload.relays.QX0}\"><div class=\"dot\"></div>QX0<small>RELAY 1</small></div>\n          <div class=\"led\" ng-class=\"{on:msg.payload.relays.QX1}\"><div class=\"dot\"></div>QX1<small>RELAY 2</small></div>\n          <div class=\"led\" ng-class=\"{on:msg.payload.relays.QX2}\"><div class=\"dot\"></div>QX2<small>RELAY 3</small></div>\n          <div class=\"led\" ng-class=\"{on:msg.payload.relays.QX3}\"><div class=\"dot\"></div>QX3<small>RELAY 4</small></div>\n          <div class=\"led\" ng-class=\"{on:msg.payload.relays.SSR1}\"><div class=\"dot\"></div>SSR1</div>\n          <div class=\"led\" ng-class=\"{on:msg.payload.relays.SSR2}\"><div class=\"dot\"></div>SSR2</div>\n          <div class=\"led\" ng-class=\"{on:msg.payload.relays.RUN}\"><div class=\"dot\"></div>RUN</div>\n        </div>\n      </div>\n      <div class=\"card\">\n        <h3>Wired inputs IN1&ndash;IN8</h3>\n        <div class=\"leds\">\n          <div class=\"led in\" ng-class=\"{on:msg.payload.inputs.START}\"><div class=\"dot\"></div>IN1<small>start_pb</small></div>\n          <div class=\"led in\" ng-class=\"{on:msg.payload.inputs.STOP}\"><div class=\"dot\"></div>IN2<small>stop_pb</small></div>\n          <div class=\"led in\" ng-class=\"{on:msg.payload.inputs.ESTOP_OK}\"><div class=\"dot\"></div>IN3<small>estop_ok (NC)</small></div>\n          <div class=\"led in\" ng-class=\"{on:msg.payload.inputs.RESET}\"><div class=\"dot\"></div>IN4<small>reset_pb</small></div>\n          <div class=\"led ph\" ng-class=\"{on:msg.payload.btn1}\"><div class=\"dot\"></div>phone_btn1<small>reg 157</small></div>\n          <div class=\"led ph\" ng-class=\"{on:msg.payload.btn2}\"><div class=\"dot\"></div>phone_btn2<small>reg 158</small></div>\n        </div>\n      </div>\n    </div>\n    <div class=\"colR\">\n      <div class=\"card logwrap\" style=\"height:100%\">\n        <h3>&#9888; Events &amp; alarms &middot; <span style=\"color:#9fb0c3;text-transform:none;letter-spacing:0\">{{(msg.payload.log||[]).length}} events, newest first</span></h3>\n        <div class=\"log\">\n          <div class=\"lrow\" ng-class=\"'s-'+r.sev\" ng-repeat=\"r in msg.payload.log track by r.id\">\n            <span class=\"lt\">{{r.t}}</span><span class=\"lb\">{{r.sev}}</span><span class=\"lm\">{{r.m}}</span>\n          </div>\n          <div class=\"empty\" ng-if=\"!(msg.payload.log && msg.payload.log.length)\">Waiting for plant activity&hellip;</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
