    {
        "id": "fn_proc",
        "type": "function",
        "name": "process",
        "func": "const r = msg.payload;\n// reg2 = temp x10, reg30 = setpoint x10 (see plc_point_map.h)\nconst temp = {payload: (r[2]||0)/10};\nconst sp   = {payload: (r[30]||0)/10};\nreturn [temp, sp];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 120,
        "wires": [
            [
                "ui_temp"
            ],
            [
                "ui_sp"
            ]
        ],
        "z": "f_hmi"
    },
