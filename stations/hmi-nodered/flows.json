    {
        "id": "fn_stat",
        "type": "function",
        "name": "status",
        "func": "const r = msg.payload;\nconst n = v => (v==null ? 0 : v);   // Modbus may return a short array before RUN\nconst mode = ['BOOT','IDLE','RUN','FAULT'][n(r[20])] || ('mode '+n(r[20]));\nreturn [\n  {payload: mode},\n  {payload: n(r[25])},              // heartbeat\n  {payload: n(r[22]) + ' us'},      // scan max\n  {payload: n(r[23])},              // fault count\n  {payload: n(r[24])}               // forces active\n];",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
