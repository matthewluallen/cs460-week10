        "type": "function",
        "name": "status",
        "func": "const r = msg.payload;\nconst mode = ['BOOT','IDLE','RUN','FAULT'][r[20]] || r[20];\nreturn [\n  {payload: mode},\n  {payload: r[25]},                 // heartbeat\n  {payload: r[22] + ' us'},         // scan max\n  {payload: r[23]},                 // fault count\n  {payload: r[24]}                  // forces active\n];",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
