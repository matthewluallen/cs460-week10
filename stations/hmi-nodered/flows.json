    {
        "id": "fn_relay",
        "type": "function",
        "name": "coils -> leds",
        "func": "const c = msg.payload;  // array of booleans, index = coil #\n// map: 0 ESTOP,1 RELAY0,2 RELAY1,3 RELAY2,4 RELAY3,5 SSR1,6 SSR2,9 CMD_RUN\nmsg.payload = {\n  ESTOP:!!c[0], QX0:!!c[1], QX1:!!c[2], QX2:!!c[3], QX3:!!c[4],\n  SSR1:!!c[5], SSR2:!!c[6], RUN:!!c[9]\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 760,
        "wires": [
            [
                "ui_relays"
            ]
        ],
        "z": "f_hmi"
    },
    {
        "id": "ui_relays",
        "type": "ui_template",
        "group": "g_relay",
        "name": "Relay LEDs",
        "order": 1,
        "width": 6,
        "height": 2,
        "format": "<style>\n.ledrow{display:flex;flex-wrap:wrap;gap:10px}\n.led{flex:1 1 60px;text-align:center;padding:8px 4px;border-radius:8px;background:#1b2330;color:#9fb0c3;font:600 12px system-ui}\n.led .dot{width:14px;height:14px;border-radius:50%;margin:0 auto 6px;background:#30405a;box-shadow:inset 0 0 3px #000}\n.led.on{color:#eaf6ff}\n.led.on .dot{background:#39d98a;box-shadow:0 0 10px #39d98a}\n.led.estop.on .dot{background:#ff5d5d;box-shadow:0 0 10px #ff5d5d}\n</style>\n<div class=\"ledrow\">\n  <div class=\"led estop\" ng-class=\"{on:msg.payload.ESTOP}\"><div class=\"dot\"></div>E-STOP</div>\n  <div class=\"led\" ng-class=\"{on:msg.payload.QX0}\"><div class=\"dot\"></div>QX0 R0</div>\n  <div class=\"led\" ng-class=\"{on:msg.payload.QX1}\"><div class=\"dot\"></div>QX1 R1</div>\n  <div class=\"led\" ng-class=\"{on:msg.payload.QX2}\"><div class=\"dot\"></div>QX2 R2</div>\n  <div class=\"led\" ng-class=\"{on:msg.payload.QX3}\"><div class=\"dot\"></div>QX3 R3</div>\n  <div class=\"led\" ng-class=\"{on:msg.payload.SSR1}\"><div class=\"dot\"></div>SSR1</div>\n  <div class=\"led\" ng-class=\"{on:msg.payload.SSR2}\"><div class=\"dot\"></div>SSR2</div>\n  <div class=\"led\" ng-class=\"{on:msg.payload.RUN}\"><div class=\"dot\"></div>RUN</div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 650,
        "y": 760,
