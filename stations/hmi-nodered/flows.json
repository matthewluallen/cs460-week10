    {
        "id": "fn_phone",
        "type": "function",
        "name": "phone points",
        "func": "const r = msg.payload;  // index 0 = register 140 (sbom/firmware/point_map.json phone_points)\n// Every phone point has its own 8 s freshness bit (reg 159 = points 0-15, reg 160 = 16+).\n// A stale value FREEZES at its last sample, so show 0 unless the point is fresh.\nconst n = v => (v==null ? 0 : v);\nconst s16 = v => (n(v) & 0x8000) ? n(v) - 0x10000 : n(v);\nconst fresh = (n(r[20]) << 16 | n(r[19])) >>> 0;\nconst f = i => ((fresh >>> i) & 1) === 1;\nconst lux  = {payload: f(0) ? n(r[0]) : 0};          // phone_light_lux (reg 140)\nconst acc  = {payload: f(1) ? n(r[1]) / 100 : 0};    // phone_accel_x100 (reg 141)\nconst tilt = {payload: f(6) ? s16(r[6]) : 0};        // phone_tilt_b (reg 146)\nconst btn  = {payload: {BTN1: f(15) && n(r[17]) === 1, BTN2: f(16) && n(r[18]) === 1}}; // regs 157/158\nreturn [lux, acc, tilt, btn];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 560,
        "wires": [
            [
                "ui_lux"
            ],
            [
                "ui_acc"
            ],
            [
                "ui_tilt"
            ],
            [
                "ui_pbtn"
            ]
        ],
        "z": "f_hmi"
    },
