    {
        "id": "fn_merge",
        "type": "function",
        "name": "merge + events",
        "func": "// One hub: decode all four reads, keep the world + a rolling event log, and emit the\n// full merged payload (for the single-screen template) on every poll.\nconst n = v => (v==null ? 0 : v);\nconst s16 = v => (n(v)&0x8000)?n(v)-0x10000:n(v);\nconst T = () => { const d=new Date(); const p=x=>('0'+x).slice(-2); return p(d.getHours())+':'+p(d.getMinutes())+':'+p(d.getSeconds()); };\nlet w = flow.get('world') || {relays:{},inputs:{}};\n\nif (msg.topic === 'hr') {\n  const r = msg.payload; const mi = n(r[20]);\n  w.modeClass = ['BOOT','IDLE','RUN','FAULT'][mi] || 'UNK';\n  w.mode = ['BOOT','IDLE','RUN','FAULT'][mi] || ('MODE'+mi);\n  w.scan = n(r[22]); w.faults = n(r[23]); w.forces = n(r[24]); w.hb = n(r[25]);\n  w.temp = (n(r[2])/10); w.sp = (n(r[30])/10);\n} else if (msg.topic === 'coil') {\n  const c = msg.payload;\n  w.relays = {ESTOP:!!c[0],QX0:!!c[1],QX1:!!c[2],QX2:!!c[3],QX3:!!c[4],SSR1:!!c[5],SSR2:!!c[6],RUN:!!c[9]};\n} else if (msg.topic === 'di') {\n  const c = msg.payload;\n  w.inputs = {START:!!c[0],STOP:!!c[1],ESTOP_OK:!!c[2],RESET:!!c[3]};\n} else if (msg.topic === 'phone') {\n  const r = msg.payload; const fresh = ((n(r[20])<<16)|n(r[19]))>>>0; const f = i => ((fresh>>>i)&1)===1;\n  w.lux = f(0)?n(r[0]):0; w.acc = f(1)?(n(r[1])/100):0; w.tilt = f(6)?s16(r[6]):0;\n  w.btn1 = f(15)&&n(r[17])===1; w.btn2 = f(16)&&n(r[18])===1; w.phoneStale = !f(0);\n}\nflow.set('world', w);\n\n// --- event detection ---\nconst prev = flow.get('prev');\nconst ev = [];\nconst push = (sev,m) => ev.push({sev,m,t:T()});\nif (!prev) {\n  push('INFO','HMI station connected — polling PLC 10.20.30.10 over Modbus/TCP :502');\n} else {\n  if (w.mode && prev.mode && w.mode!==prev.mode) push(w.mode==='FAULT'?'ALARM':'INFO','Controller mode '+prev.mode+' → '+w.mode);\n  if (w.faults>0 && !(prev.faults>0)) push('ALARM','Controller fault latched (count '+w.faults+')');\n  if (!(w.faults>0) && prev.faults>0) push('INFO','Fault cleared by operator reset');\n  if (w.forces>0 && !(prev.forces>0)) push('WARN','Forces active — '+w.forces+' output(s) overridden from the console');\n  if (!(w.forces>0) && prev.forces>0) push('INFO','Forces released — outputs follow the program again');\n  if (w.inputs && prev.inputs) {\n    if (w.inputs.ESTOP_OK===false && prev.inputs.ESTOP_OK!==false) push('ALARM','E-STOP opened — safety chain not healthy (IN3)');\n    if (w.inputs.ESTOP_OK===true && prev.inputs.ESTOP_OK===false) push('INFO','E-STOP restored — chain healthy');\n    const inm = {START:'IN1 start_pb',STOP:'IN2 stop_pb',RESET:'IN4 reset_pb'};\n    ['START','STOP','RESET'].forEach(k => { if (w.inputs[k]!==prev.inputs[k]) push('INFO', inm[k]+' '+(w.inputs[k]?'asserted':'released')); });\n  }\n  if (w.relays && prev.relays) {\n    const nm = {QX0:'RELAY 1 (motor)',QX1:'RELAY 2 (run light)',QX2:'RELAY 3 (phone alarm)',QX3:'RELAY 4 (fault lamp)',SSR1:'SSR1',SSR2:'SSR2'};\n    ['QX0','QX1','QX2','QX3','SSR1','SSR2'].forEach(k => {\n      if (w.relays[k]!==prev.relays[k]) {\n        const on = w.relays[k];\n        if (k==='QX0' && on && w.inputs && !w.inputs.START && w.mode!=='RUN')\n          push('SEC','RELAY 1 energized with no local START — possible network/forced write (Modbus has no auth, CWE-306)');\n        else push('INFO', nm[k]+' → '+(on?'ON':'OFF'));\n      }\n    });\n  }\n  if (w.phoneStale===true && prev.phoneStale!==true) push('WARN','Phone sensor point went stale (>8 s) — value frozen at last sample');\n  if (w.phoneStale===false && prev.phoneStale===true) push('INFO','Phone sensor point fresh again');\n}\nflow.set('prev', JSON.parse(JSON.stringify(w)));\n\nlet log = flow.get('log') || [];\nif (ev.length) { ev.forEach(e => { const id=(flow.get('eid')||0)+1; flow.set('eid',id); e.id=id; log.unshift(e); }); if (log.length>60) log=log.slice(0,60); flow.set('log',log); }\n\nif (w.mode == null) return null;   // wait until the first HR read\nconst r1 = x => Math.round(x*10)/10;\nmsg.payload = {\n  mode:w.mode, modeClass:w.modeClass, hb:w.hb, scan:w.scan, faults:w.faults, forces:w.forces,\n  temp:r1(w.temp||0), sp:r1(w.sp||0), lux:Math.round(w.lux||0), acc:r1(w.acc||0), tilt:Math.round(w.tilt||0),\n  btn1:!!w.btn1, btn2:!!w.btn2, relays:w.relays||{}, inputs:w.inputs||{}, clock:T(), log:log\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 270,
        "wires": [
